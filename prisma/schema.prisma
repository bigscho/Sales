generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model TeamMember {
  id                      String   @id @default(cuid())
  name                    String
  role                    String   // setter | closer | show_rate_rep
  tier                    Int      @default(1) // 1-4 for setters
  pin                     String?  // 4-6 digit login PIN
  isAdmin                 Boolean  @default(false)
  slackUserId             String?  // Slack member ID for @mentions (e.g. U0APNBM43S7)
  cumulativeShows         Int      @default(0)
  consecutive15PlusWeeks  Int      @default(0)
  excludeFromLeaderboard  Boolean  @default(false)
  isActive                Boolean  @default(true)
  creditBalance           Int      @default(0) // cached text blast credit balance
  blastZones              String?  // JSON: [{"state":"TX","cities":["Austin"],"minProd":5,"maxProd":50}]
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  bookings           Booking[]
  demosAsCLoser      Demo[]               @relation("CloserDemos")
  deals              Deal[]
  payrollItems       PayrollLineItem[]
  dailyScores        SetterDailyScore[]
  verifications      SetterVerification[]
  creditTransactions CreditTransaction[]
  textBlasts         TextBlast[]
}

model Week {
  id          String    @id @default(cuid())
  weekStart   DateTime
  weekEnd     DateTime
  status      String    @default("draft") // draft | confirmed
  confirmedBy String?
  confirmedAt DateTime?
  notes       String?
  createdAt   DateTime  @default(now())

  bookings           Booking[]
  demos              Demo[]
  deals              Deal[]
  payments           Payment[]
  payrollRuns        PayrollRun[]
  expenses           Expense[]
  dayLocks           DayLock[]
  verifications      SetterVerification[]
  creditTransactions CreditTransaction[]

  @@unique([weekStart])
}

model Booking {
  id               String   @id @default(cuid())
  weekId           String
  prospectName     String
  prospectEmail    String?
  prospectPhone    String?
  setterId         String?
  bookedAt         DateTime?
  demoDate         DateTime
  calendarEventId  String?  @unique
  airtableRecordId String?
  listingAddress   String?  // Calendly "Listing address / zip codes" free-text (setter-entered); blank -> DB area fallback
  prospectTimezone String?  // IANA tz from Calendly invitee, for prospect-local send timing
  source           String   @default("auto") // auto | manual
  blastSourced     Boolean  @default(false) // true if prospect was SMS-blasted within 14 days
  // Immutable-history model: a reschedule/rebook never moves a row to another week.
  // Instead the old row is frozen (supersededAt set) and a successor row is created,
  // linked via rescheduledFromId. Frozen rows keep their week's activity + outcome forever.
  supersededAt      DateTime?
  rescheduledFromId String?  @unique
  createdAt        DateTime @default(now())

  week              Week        @relation(fields: [weekId], references: [id])
  setter            TeamMember? @relation(fields: [setterId], references: [id])
  demo              Demo?
  confirmationSends ConfirmationSend[]
  rescheduledFrom   Booking?    @relation("RescheduleChain", fields: [rescheduledFromId], references: [id])
  rescheduledTo     Booking?    @relation("RescheduleChain")
}

model Demo {
  id                     String    @id @default(cuid())
  bookingId              String    @unique
  weekId                 String
  closerId               String?
  status                 String    @default("pending") // pending | showed | no_show | cancelled | rescheduled
  confirmedBy            String?
  confirmedAt            DateTime?
  firefliesTranscriptId  String?
  hasFirefliesRecording  Boolean   @default(false)
  notes                  String?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  booking Booking    @relation(fields: [bookingId], references: [id])
  week    Week       @relation(fields: [weekId], references: [id])
  closer  TeamMember? @relation("CloserDemos", fields: [closerId], references: [id])
  deal    Deal?
  flags   SetterFlag[]
}

model Deal {
  id                   String    @id @default(cuid())
  demoId               String?   @unique
  weekId               String
  closerId             String?
  prospectName         String
  prospectEmail        String?
  stripeCustomerId     String?
  stripeSubscriptionId String?
  dealType             String    @default("subscription") // subscription | one_time
  month1Cash           Int       @default(0) // cents
  status               String    @default("pending") // closed_won | closed_lost | pending | held
  closedAt             DateTime?
  notes                String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  demo     Demo?       @relation(fields: [demoId], references: [id])
  week     Week        @relation(fields: [weekId], references: [id])
  closer   TeamMember? @relation(fields: [closerId], references: [id])
  payments Payment[]
}

model Payment {
  id                    String   @id @default(cuid())
  dealId                String?
  weekId                String?
  stripePaymentIntentId String?  @unique
  stripeCustomerId      String?
  stripeSubscriptionId  String?  // set only if payment is from an actual subscription
  amountCents           Int
  refundedCents         Int      @default(0)  // total refunded amount
  currency              String   @default("usd")
  status                String   // succeeded | pending | failed | refunded | partially_refunded | disputed
  paidAt                DateTime
  isMonth1              Boolean  @default(false)
  isSubscription        Boolean  @default(false) // true = subscription, false = one-time
  revenueType           String   @default("unknown") // mrr | one_time | misc | unknown
  revenueTypeOverride   String?  // manual override for revenue type
  customerStatus        String   @default("unknown") // new | returning | unknown
  customerStatusOverride String? // manual override for customer status
  customerName          String?
  customerEmail         String?
  matchStatus           String   @default("unmatched") // matched | unmatched | needs_review
  matchReason           String?
  createdAt             DateTime @default(now())

  deal Deal? @relation(fields: [dealId], references: [id])
  week Week? @relation(fields: [weekId], references: [id])
}

model PayrollRun {
  id          String    @id @default(cuid())
  weekId      String
  status      String    @default("draft") // draft | confirmed | paid
  createdAt   DateTime  @default(now())
  confirmedAt DateTime?

  week      Week              @relation(fields: [weekId], references: [id])
  lineItems PayrollLineItem[]
}

model PayrollLineItem {
  id           String @id @default(cuid())
  payrollRunId String
  teamMemberId String
  lineType     String // base | per_show | commission | show_rate_bonus
  description  String
  quantity     Float  @default(0)
  rateCents    Int    @default(0)
  amountCents  Int

  payrollRun PayrollRun @relation(fields: [payrollRunId], references: [id], onDelete: Cascade)
  teamMember TeamMember @relation(fields: [teamMemberId], references: [id])
}

model Expense {
  id         String   @id @default(cuid())
  weekId     String
  category   String
  vendor     String?
  description String?
  amountCents Int
  date       DateTime
  source     String   @default("manual") // manual | csv_import
  createdAt  DateTime @default(now())

  week Week @relation(fields: [weekId], references: [id])
}

model ExpenseCategory {
  id        String  @id @default(cuid())
  name      String  @unique
  isActive  Boolean @default(true)
  sortOrder Int     @default(0)
}

model SyncLog {
  id            String    @id @default(cuid())
  source        String    // stripe | gcal | airtable | fireflies
  syncType      String
  status        String    // success | error
  recordsSynced Int       @default(0)
  errorMessage  String?
  startedAt     DateTime  @default(now())
  completedAt   DateTime?
}

model AuditLog {
  id         String   @id @default(cuid())
  entityType String
  entityId   String
  action     String
  oldValue   String?  // JSON
  newValue   String?  // JSON
  performedBy String?
  createdAt  DateTime @default(now())
}

model DayLock {
  id          String   @id @default(cuid())
  weekId      String
  date        DateTime
  dayOfWeek   Int
  demoCount   Int      @default(0)
  showCount   Int      @default(0)
  noShowCount Int      @default(0)
  cashCents   Int      @default(0)
  lockedBy    String   @default("admin")
  lockedAt    DateTime @default(now())

  week Week @relation(fields: [weekId], references: [id])

  @@unique([weekId, date])
}

model DismissedEvent {
  id              String   @id @default(cuid())
  calendarEventId String   @unique
  reason          String   @default("deleted")
  dismissedAt     DateTime @default(now())
}

model SetterDailyScore {
  id            String   @id @default(cuid())
  setterId      String
  date          DateTime
  bookings      Int      @default(0)
  pigeonTier    String   @default("sad_pigeon")
  points        Int      @default(0)
  tierCrossings String   @default("") // CSV of thresholds already fired: "4,9,12"
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  setter TeamMember @relation(fields: [setterId], references: [id])

  @@unique([setterId, date])
}

// === SETTER VERIFICATION ===

model SetterVerification {
  id          String    @id @default(cuid())
  setterId    String
  weekId      String
  status      String    @default("pending") // pending | confirmed | has_flags
  confirmedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  setter TeamMember       @relation(fields: [setterId], references: [id])
  week   Week             @relation(fields: [weekId], references: [id])
  flags  SetterFlag[]

  @@unique([setterId, weekId])
}

model SetterFlag {
  id              String   @id @default(cuid())
  verificationId  String
  demoId          String?  // null for "missing demo" flags
  flagType        String   // wrong_status | not_mine | missing_demo
  note            String?
  // For missing_demo flags
  missingProspectName  String?
  missingProspectEmail String?
  missingDemoDate      String?  // approximate date as text
  ceoAction       String   @default("pending") // pending | approved | rejected
  ceoNote         String?
  resolvedAt      DateTime?
  createdAt       DateTime @default(now())

  verification SetterVerification @relation(fields: [verificationId], references: [id])
  demo         Demo?              @relation(fields: [demoId], references: [id])
}

// === OUTBOUND CONSOLE ===

model Agent {
  id                 String    @id @default(cuid())
  firstName          String
  lastName           String
  email              String?
  phone              String?
  state              String?
  city               String?
  zip                String?
  brokerage          String?
  licenseNumber      String?
  yearsExperience    Int?
  homeTypes          String?   // comma-separated from homes.com
  mlsNumber          String?
  totalTransactions  Int?      // 5-year total from homes.com
  totalVolumeCents   BigInt?   // 5-year total sales volume in cents
  avgTransactions    Int?      // calculated: totalTransactions / 5
  avgVolumeCents     BigInt?   // calculated: totalVolumeCents / 5
  lastContactedAt      DateTime? // when last pushed to any campaign
  lastContactedChannel String?   // smartlead | ghl
  contactCount         Int       @default(0)
  source             String    @default("csv_import")
  importBatch        String?   // tracks which import brought this record in
  emailVerifyStatus  String?   // valid | invalid | risky | unknown
  emailVerifiedAt    DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  outboundPushes     OutboundPush[]

  @@unique([email])
  @@index([state, city])
  @@index([avgTransactions])
  @@index([lastName, firstName])
}

model OutboundCampaign {
  id                  String    @id @default(cuid())
  name                String
  channel             String    // smartlead | ghl
  externalId          String?   // Smartlead campaign ID or GHL workflow ID
  ghlSubAccountId     String?   // which GHL sub-account this uses
  status              String    @default("active") // active | paused | completed
  totalPushed         Int       @default(0)
  totalSent           Int       @default(0)
  totalOpened         Int       @default(0)
  totalReplied        Int       @default(0)
  openRate            Float?
  replyRate           Float?
  lastSyncedAt        DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  pushes              OutboundPush[]
  scheduledPushes     ScheduledPush[]
  blasts              TextBlast[]
}

model OutboundPush {
  id           String   @id @default(cuid())
  agentId      String
  campaignId   String
  channel      String   // smartlead | ghl
  blastId      String?  // links to TextBlast if sent via credit system
  pushedAt     DateTime @default(now())
  pushedBy     String?

  agent        Agent            @relation(fields: [agentId], references: [id])
  campaign     OutboundCampaign @relation(fields: [campaignId], references: [id])
  blast        TextBlast?       @relation(fields: [blastId], references: [id])

  @@unique([agentId, campaignId])
  @@index([campaignId])
  @@index([agentId])
  @@index([blastId])
}

model ScheduledPush {
  id              String    @id @default(cuid())
  campaignId      String
  name            String
  filterState     String?
  filterCity      String?
  filterMinProd   Int?
  filterMaxProd   Int?
  batchSize       Int       @default(200)
  frequency       String    // daily | weekly | one_time
  dayOfWeek       Int?      // 0-6 for weekly
  timeOfDay       String?   // "09:00" ET
  nextRunAt       DateTime?
  lastRunAt       DateTime?
  isActive        Boolean   @default(true)
  createdBy       String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  campaign        OutboundCampaign @relation(fields: [campaignId], references: [id])
}

// === TEXT BLAST CREDITS ===

model CreditTransaction {
  id          String   @id @default(cuid())
  setterId    String
  amount      Int      // positive = earned, negative = spent
  balance     Int      // running balance after this transaction
  type        String   // weekly_award | verification_bonus | pigeon_bonus | blast_spend | admin_adjust | refund
  description String   // human-readable: "Week of Mar 30: 22 bookings, 68% show rate"
  weekId      String?  // which week this award is for (nullable for adjustments)
  blastId     String?  // links to TextBlast if type = blast_spend
  createdAt   DateTime @default(now())

  setter      TeamMember @relation(fields: [setterId], references: [id])
  week        Week?      @relation(fields: [weekId], references: [id])
  blast       TextBlast? @relation(fields: [blastId], references: [id])

  @@index([setterId, createdAt])
  @@index([weekId])
}

model TextBlast {
  id              String    @id @default(cuid())
  setterId        String
  creditsSpent    Int       // 1 credit = 1 SMS contact
  status          String    @default("pending") // pending | processing | completed | failed | scheduled
  scheduledFor    DateTime? // null = send immediately
  filterState     String?
  filterCity      String?
  filterMinProd   Int?
  filterMaxProd   Int?
  filterMinVolume BigInt?   // min avg annual volume in cents
  filterMaxVolume BigInt?   // max avg annual volume in cents
  campaignId      String?   // links to OutboundCampaign used
  totalPushed     Int       @default(0) // actual contacts pushed to GHL
  totalFailed     Int       @default(0)
  startedAt       DateTime?
  completedAt     DateTime?
  errorMessage    String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  setter          TeamMember         @relation(fields: [setterId], references: [id])
  campaign        OutboundCampaign?  @relation(fields: [campaignId], references: [id])
  creditTx        CreditTransaction[]
  pushes          OutboundPush[]

  @@index([setterId])
  @@index([status])
  @@index([scheduledFor])
}

model GhlWarmupTracker {
  id              String   @id @default(cuid())
  subAccountId    String   // "1" or "2" — maps to GHL_API_KEY_1, GHL_API_KEY_2
  date            DateTime // date (day granularity)
  sentCount       Int      @default(0)
  dailyLimit      Int      // the allowed max for this day
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([subAccountId, date])
}

// ── CEO Financial Dashboard Models ──────────────────────────────────

model Transaction {
  id               String    @id @default(cuid())
  externalId       String?
  source           String    // mercury | stripe | amex
  date             DateTime
  amountCents      Int       // positive = inflow, negative = outflow
  merchantName     String?
  description      String?
  classification   String    @default("needs_review") // business | personal | payroll | internal_transfer | needs_review
  categoryId       String?
  status           String    @default("needs_review") // auto_categorized | needs_review | confirmed
  confidenceScore  Float     @default(0)
  stripePaymentId  String?
  weeklyCloseId    String?
  adjustmentForId  String?
  notes            String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  category      FinancialCategory? @relation(fields: [categoryId], references: [id])
  weeklyClose   WeeklyClose?       @relation(fields: [weeklyCloseId], references: [id])
  adjustmentFor Transaction?       @relation("TransactionAdjustments", fields: [adjustmentForId], references: [id], onDelete: SetNull)
  adjustments   Transaction[]      @relation("TransactionAdjustments")

  @@unique([source, externalId])
  @@index([date])
  @@index([classification])
  @@index([status])
}

model FinancialCategory {
  id        String   @id @default(cuid())
  name      String   @unique
  type        String   @default("business") // business | personal | payroll
  costPurpose String   @default("overhead") // cogs | cac | overhead
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt DateTime @default(now())

  transactions    Transaction[]
  merchantMappings MerchantMapping[]
}

model MerchantMapping {
  id              String   @id @default(cuid())
  merchantPattern String   @unique
  classification  String   // business | personal | payroll | internal_transfer
  categoryId      String?
  confidence      Float    @default(0.5)
  timesConfirmed  Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  category FinancialCategory? @relation(fields: [categoryId], references: [id])
}

model WeeklyClose {
  id               String    @id @default(cuid())
  weekStart        DateTime
  weekEnd          DateTime
  status           String    @default("pending") // pending | confirmed
  confirmedAt      DateTime?
  transactionCount Int       @default(0)
  reviewedCount    Int       @default(0)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  transactions Transaction[]

  @@unique([weekStart])
}

model MonthlyClose {
  id                String    @id @default(cuid())
  month             Int
  year              Int
  status            String    @default("open") // open | confirmed
  confirmedAt       DateTime?
  totalRevenueCents Int       @default(0)
  totalExpensesCents Int      @default(0)
  totalPayrollCents Int       @default(0)
  totalPersonalCents Int      @default(0)
  netProfitCents    Int       @default(0)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@unique([month, year])
}

model MrrEvent {
  id                   String   @id @default(cuid())
  type                 String   // new_subscription | churn | reactivation
  clientName           String
  mrrAmountCents       Int
  effectiveDate        DateTime
  stripeSubscriptionId String?
  notes                String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

// === SHOW-RATE CONFIRMATIONS (SendBlue) ===
// Deliberately thin: worklist state (case type, address variable, frozen count,
// skip reasons) is computed live from Booking/Demo — the only things persisted
// are what can't be recomputed: the group_id mapping and the send log.

// Maps a SendBlue iMessage group (captured via inbound webhook) to a prospect
// phone / booking. The AI Agent line can only reply into groups it's in, so
// this mapping is the send routing table.
model SendblueGroup {
  id            String    @id @default(cuid())
  groupId       String    @unique
  participants  String?   // JSON array of E.164 numbers seen in the group
  prospectPhone String?   // the participant matched to a booking's prospectPhone
  bookingId     String?   // matched booking (null until matched)
  lastInboundAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([prospectPhone])
  @@index([bookingId])
}

// Append-only log of every send attempt. Drives the cross-booking "ever texted
// this prospect the ask" dedup, the std-vs-again day-of variant, and the
// automation-readiness instrumentation (edit rate, catches, auto-send share).
model ConfirmationSend {
  id                String    @id @default(cuid())
  bookingId         String
  prospectEmail     String?   // denormalized for cross-booking dedup
  prospectPhone     String?
  touchpoint        String    // t1 | day_of
  variant           String?   // standard | again (day-of only)
  addressSource     String?   // calendly | db_fallback | none (t1 only — readiness metric)
  body              String
  status            String    @default("queued") // queued | sent | failed | skipped
  groupId           String?
  sendblueMessageId String?
  error             String?
  // QA instrumentation for automation-readiness
  edited            Boolean   @default(false)  // rep changed the text before sending
  autoSent          Boolean   @default(false)  // fired by cron without manual approval
  approvedBy        String?                    // TeamMember id who approved (null if auto)
  dryRun            Boolean   @default(true)
  sentAt            DateTime?
  createdAt         DateTime  @default(now())

  booking Booking @relation(fields: [bookingId], references: [id])

  @@index([prospectEmail, touchpoint, status])
  @@index([prospectPhone, touchpoint, status])
  @@index([bookingId])
}
